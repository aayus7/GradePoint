<!DOCTYPE html>
<html>
	<head>
		<title>GradePoint | Team Solo</title>
		<style>
			body {
				font-family: sans-serif;
				max-width: 800px;
				margin: 0 auto;
				padding: 20px;
			}
			.course-card {
				border: 1px solid #ddd;
				padding: 10px;
				margin: 10px 0;
				border-left: 5px solid green;
			}
			form {
				background: #f4f4f4;
				padding: 20px;
				margin-bottom: 20px;
			}
			input {
				padding: 10px;
				margin-right: 10px;
			}
			button {
				padding: 10px;
				cursor: pointer;
			}
			.delete {
				float: right;
				color: red;
				cursor: pointer;
			}
		</style>
	</head>
	<body>
		<h1>GradePoint Dashboard</h1>

		<form action="/courses" method="POST">
			<label>Subject:</label>
			<input
				type="text"
				name="subject"
				required
				placeholder="e.g. Math"
			/>
			<label>Grade (%):</label>
			<input type="number" name="grade" required placeholder="85" />
			<button>Add Course</button>
		</form>

		<h2>My Courses</h2>

		<% if (courses.length > 0) { %> <% courses.forEach(course => { %>
		<div class="course-card">
			<h3>
				<%= course.subject %>: <%= course.grade %>%
				<a class="delete" data-doc="<%= course._id %>">DELETE</a>
			</h3>
		</div>
		<% }) %> <% } else { %>
		<p>No courses yet. Add one above!</p>
		<% } %>

		<script>
			const trashcans = document.querySelectorAll("a.delete");
			trashcans.forEach((t) => {
				t.addEventListener("click", (e) => {
					const endpoint = `/courses/${t.dataset.doc}`;
					fetch(endpoint, { method: "DELETE" })
						.then((response) => response.json())
						.then((data) => (window.location.href = data.redirect))
						.catch((err) => console.log(err));
				});
			});
		</script>
	</body>
</html>
