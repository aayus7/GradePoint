<!DOCTYPE html>
<html>
	<head>
		<title>Edit Course | GradePoint</title>
		<style>
			body {
				font-family: sans-serif;
				max-width: 800px;
				margin: 0 auto;
				padding: 20px;
			}
			form {
				background: #f4f4f4;
				padding: 20px;
				margin-bottom: 20px;
				/* Different border color to distinguish from "Add" form */
				border-left: 5px solid #007bff;
			}
			input {
				padding: 10px;
				margin-right: 10px;
			}
			button {
				padding: 10px;
				cursor: pointer;
				background-color: #007bff;
				color: white;
				border: none;
			}
			button:hover {
				background-color: #0056b3;
			}
			.cancel-link {
				margin-left: 15px;
				text-decoration: none;
				color: #555;
			}
			.cancel-link:hover {
				text-decoration: underline;
				color: black;
			}
		</style>
	</head>
	<body>
		<h1>Edit Course</h1>

		<!-- Form Action points to the Update Route we created -->
		<form action="/courses/update/<%= course._id %>" method="POST">
			<label>Subject:</label>
			<input
				type="text"
				name="subject"
				required
				value="<%= course.subject %>"
			/>

			<label>Grade (%):</label>
			<input
				type="number"
				name="grade"
				required
				value="<%= course.grade %>"
			/>

			<button type="submit">Update Course</button>
			<a href="/courses" class="cancel-link">Cancel</a>
		</form>
	</body>
</html>
